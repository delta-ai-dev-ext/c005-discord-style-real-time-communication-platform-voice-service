    "kafkajs": "^2.2.4",
    "livekit-server-sdk": "^2.19.2",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
